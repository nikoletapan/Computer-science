    <h1>Hello!</h1>
    <h3>@ViewData["PageTitle"] : ViewData</h3>
    @{ 
        var e = ViewData["Employee"] as EmployeeManagement.Models.Employee;
    }
    <div>Id: @e.Id</div>
    <div>Name: @e.Name</div>
    <div>Family: @e.Family</div>
    <div>Phone: @e.Phone</div>
    <div>Email: @e.Email</div>
    <div>Department: @e.Department</div>
    <br />
    <hr>
    <h3>@ViewBag.PageTitle : ViewBag</h3>
    <div>Id: @ViewBag.Employee.Id</div>
    <div>Name: @ViewBag.Employee.Name</div>
    <div>Family: @ViewBag.Employee.Family</div>
    <div>Phone: @ViewBag.Employee.Phone</div>
    <div>Email: @ViewBag.Employee.Email</div>
    <div>Department: @ViewBag.Employee.Department</div>
    <br />
    <hr>
    <h3>@ViewBag.PageTitle : Model - Loosely typed view</h3>
    <div>Id: @Model.Id</div>
    <div>Name: @Model.Name</div>
    <div>Family: @Model.Family</div>
    <div>Phone: @Model.Phone</div>
    <div>Email: @Model.Email</div>
    <div>Department: @Model.Department</div>
    <br />
    <hr>
