@model Shakesperiada.Models.Quote

@{
    ViewData["Title"] = "Delete";
}

<h1>Изтрий</h1>

<h3>Сигурен ли сте, че искате да изтриете цитата?</h3>
<div>
    <h4>Цитат</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Превод на български:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.QuoteBG)
        </dd>
        <dt class = "col-sm-2">
            В оригинал на английски:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.QuoteEN)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий" class="btn btn-danger" /> |
        <a asp-action="Index">Обратно в списъка</a>
    </form>
</div>
